# Local development values only. Do not use these defaults outside local development.
POSTGRES_DB=molarai
POSTGRES_USER=molarai
POSTGRES_PASSWORD=local_dev_only_change_me
POSTGRES_HOST_PORT=5432
DATABASE_URL=jdbc:postgresql://localhost:5432/molarai
DATABASE_USERNAME=molarai
DATABASE_PASSWORD=local_dev_only_change_me

# Local Ollama embeddings are the default and require no API key.
EMBEDDING_PROVIDER=ollama
OLLAMA_EMBEDDING_BASE_URL=http://localhost:11434
# Chat uses local Ollama by default. For Ollama Cloud, set base URL to https://ollama.com/api,
# model to gpt-oss:120b-cloud, and provide OLLAMA_API_KEY through a local, untracked .env file.
OLLAMA_CHAT_BASE_URL=http://localhost:11434/api
OLLAMA_CHAT_MODEL=qwen3:4b
OLLAMA_API_KEY=
OLLAMA_CHAT_MAX_OUTPUT_TOKENS=512
# Legacy local chat host fallback; OLLAMA_CHAT_BASE_URL takes precedence.
OLLAMA_BASE_URL=http://localhost:11434
APPOINTMENT_TIME_ZONE=America/Los_Angeles
CANCELLATION_ENABLED=true
EMBEDDING_MODEL=embeddinggemma
EMBEDDING_DIMENSION=768

# Optional hosted provider. Set EMBEDDING_PROVIDER=openai and a local key to use it.
EMBEDDING_API_KEY=
EMBEDDING_API_BASE_URL=https://api.openai.com/v1

# Knowledge ingestion and chunking
KNOWLEDGE_BASE_PATH=../docs/knowledge-base
CHUNK_SIZE=1200
CHUNK_OVERLAP=150
INGEST_KNOWLEDGE_BASE=false
