# Reference only: set real values in Render's environment dashboard, not in this file.
SPRING_PROFILES_ACTIVE=prod
PORT=8080
CANCELLATION_ENABLED=false

# Supply a JDBC URL (not Render's postgres:// URL) and credentials from managed PostgreSQL.
DATABASE_URL=jdbc:postgresql://your-db-host:5432/your-database?sslmode=require
DATABASE_USERNAME=replace-with-managed-db-user
DATABASE_PASSWORD=replace-with-managed-db-password
DATABASE_POOL_SIZE=10

# Exact frontend origins only; comma-separated for production and preview domains.
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app

# Real appointment schedule settings (do not use the sample schedule).
APPOINTMENT_TIME_ZONE=America/Los_Angeles
CLINIC_WEEKDAY_OPEN=09:00
CLINIC_WEEKDAY_CLOSE=17:00
CLINIC_SATURDAY_OPEN=09:00
CLINIC_SATURDAY_CLOSE=13:00
CLINIC_SLOT_MINUTES=30
CLINIC_DAILY_SLOT_STARTS=09:00,09:30,10:00,10:30,11:00,11:30,12:00,12:30,13:00,13:30,14:00,14:30,15:00,15:30,16:00,16:30
CLINIC_BOOKING_HORIZON_DAYS=90
CLINIC_MINIMUM_ADVANCE_MINUTES=60
CLINIC_PROVIDERS=Replace With Actual Provider
CLINIC_HOLIDAYS=

# Use one existing embedding provider. OpenAI requires EMBEDDING_API_KEY;
# Ollama requires OLLAMA_EMBEDDING_BASE_URL.
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=replace-with-provider-key
EMBEDDING_API_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=768

# Chat provider configuration.
OLLAMA_CHAT_BASE_URL=https://ollama.com/api
OLLAMA_CHAT_MODEL=gpt-oss:120b-cloud
OLLAMA_API_KEY=replace-with-provider-key

# No production OTP delivery provider is implemented yet. Do not set this to mock.
CANCELLATION_OTP_PROVIDER=replace-after-real-provider-is-implemented
